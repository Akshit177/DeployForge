# ==============================================================================
# DeployForge Environment Configuration Template
# ==============================================================================

# Core Control Plane Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security Secrets (Required in production: minimum 32 chars, distinct, no defaults)
# Generate secrets using: openssl rand -base64 32
JWT_SECRET=super-secret-deployforge-key-change-me-in-production
# Generate distinct encryption key: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Demo User Seeding (optional, only honored when NODE_ENV != production)
# Set to 'true' to seed demo user (anurag@deployforge.dev / password123)
SEED_DEMO=false

# PostgreSQL 16 Database Configuration
# In production, DB_PASSWORD must NOT be 'postgres'
DB_HOST=localhost
DB_PORT=5432
DB_NAME=deployforge
DB_USER=postgres
DB_PASSWORD=postgres

# Redis 7 In-Memory Cache & Streams
REDIS_HOST=localhost
REDIS_PORT=6379

# Execution Engine Configuration (cpp | node)
# 'cpp' delegates to native C++ worker; 'node' uses in-process Node deployment worker for automated tests
EXECUTION_ENGINE=node
ENABLE_NODE_DEPLOYMENT_WORKER=true
ENABLE_OUTBOX=true
ENABLE_PERSISTENCE=true

# Container Runtime & Docker Daemon
# 'simulator' mocks container lifecycle; 'real' connects to local Docker daemon via /var/run/docker.sock
DOCKER_MODE=simulator
APP_NETWORK=deployforge-apps
WORKSPACE_BASE_PATH=/var/lib/deployforge/workspaces
NGINX_UPSTREAMS_PATH=./nginx/conf.d/deployforge-upstreams.conf

# Frontend Development Server Proxy
VITE_API_URL=http://localhost:3000
